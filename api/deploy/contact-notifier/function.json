{
  "FunctionName": "{{ ssm `/pb/prod/contact_notifier/function_name` }}",
  "Role": "{{ ssm `/pb/prod/contact_notifier/role_arn` }}",
  "Runtime": "nodejs22.x",
  "Handler": "index.handler",
  "Architectures": [
    "x86_64"
  ],
  "MemorySize": 512,
  "Timeout": 60,
  "Environment": {
    "Variables": {
      "EMAIL_SECRETS_ARN": "{{ ssm `/pb/prod/secrets/contact_email_arn` }}",
      "DISCORD_SECRETS_ARN": "{{ ssm `/pb/prod/secrets/contact_discord_arn` }}"
    }
  },
  "LoggingConfig": {
    "LogFormat": "JSON",
    "ApplicationLogLevel": "INFO",
    "SystemLogLevel": "WARN"
  },
  "Tags": {
    "Service": "pursuit-blog",
    "ManagedBy": "terraform",
    "Repo": "private-aws"
  }
}
